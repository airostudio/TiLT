{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TiLT",
  "version": "0.1.0",
  "identifier": "studio.airo.tilt",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TiLT",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Arcade front end with Amiga Studio",
    "licenseFile": "../../../LICENSE",
    "resources": { "resources/engine": "engine" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
